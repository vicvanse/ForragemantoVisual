# Sessões: 1 = teste (6 sessões, começa/termina 60vs60); 2 = ideal (10 sessões)
NEXT_PUBLIC_SESSION_REPS=1
NEXT_PUBLIC_SESSION_DURATION_S=420
NEXT_PUBLIC_INTER_SESSION_BREAK_S=300

# —— Persistência (obrigatório na Vercel) ——
# Crie um projeto em https://supabase.com → SQL Editor → rode web/supabase/schema.sql
# Settings → API: Project URL + service_role (secret)
SUPABASE_URL=https://SEU_PROJETO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sua_service_role_key
SUPABASE_STORAGE_BUCKET=forrageamento
